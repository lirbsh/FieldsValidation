<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FieldsValidation.Views.UserPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FieldsValidation.ViewModels"
    Title="UserPage"
    x:DataType="vm:UserPageVM">
    <ScrollView>
        <VerticalStackLayout>
            <Image
                Aspect="AspectFit"
                SemanticProperties.Description="user atributes"
                Source="user_attributes.png" />
            <BoxView HeightRequest="1" Color="Blue" />
            <Grid
                Padding="5"
                ColumnDefinitions="*,2*"
                RowDefinitions="*,*,*,*,*,*,*,*">
                <Label FontSize="Title" Text="Name" />
                <Entry
                    Grid.Column="1"
                    ClearButtonVisibility="WhileEditing"
                    FontSize="Title"
                    Keyboard="Text"
                    ReturnType="Next"
                    Text="{Binding Name}" />
                <Label
                    Grid.Row="1"
                    FontSize="Title"
                    Text="User Name" />
                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    RowDefinitions="*,*">
                    <Entry
                        ClearButtonVisibility="WhileEditing"
                        FontSize="Title"
                        Keyboard="Text"
                        ReturnType="Next"
                        Text="{Binding UserName}" />
                    <Label
                        Grid.Row="1"
                        TextColor="Red"
                        IsVisible="{Binding HasUserNameError}"
                        Text="{Binding UserNameErrorMessage}" />
                </Grid>
                <Label
                    Grid.Row="2"
                    FontSize="Title"
                    Text="Email" />
                <Entry
                    Grid.Row="2"
                    Grid.Column="1"
                    ClearButtonVisibility="WhileEditing"
                    FontSize="Title"
                    Keyboard="Email"
                    ReturnType="Next"
                    Text="{Binding Email}" />
                <Label
                    Grid.Row="3"
                    FontSize="Title"
                    Text="Password" />
                <Grid
                    Grid.Row="3"
                    Grid.Column="1"
                    RowDefinitions="*,*">
                    <Entry
                        ClearButtonVisibility="WhileEditing"
                        FontSize="Title"
                        IsPassword="True"
                        Keyboard="Text"
                        ReturnType="Done"
                        Text="{Binding Password}" />
                    <Label
                        Grid.Row="1"
                        TextColor="Red"
                        IsVisible="{Binding HasUserPwdError}"
                        Text="{Binding UserPwdErrorMessage}" />
                </Grid>
                <Label
                    Grid.Row="4"
                    FontSize="Title"
                    Text="Birth Date" />
                <Grid
                    Grid.Row="4"
                    Grid.Column="1"
                    RowDefinitions="*,*">
                    <DatePicker
                        Date="{Binding BirthDate}"
                        FontSize="Title"
                        Format="dd/MM/yyyy" />
                    <Label
                        Grid.Row="1"
                        TextColor="Red"
                        IsVisible="{Binding HasUserAgeError}"
                        Text="{Binding Source={x:Static vm:UserPageVM.UserAgeErrorMessage}} " />
                </Grid>
                <Label
                    Grid.Row="5"
                    FontSize="Title"
                    Text="Age" />
                <Label
                    Grid.Row="5"
                    Grid.Column="1"
                    FontSize="Title"
                    Text="{Binding Age}" />
                <Button
                    Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,40,0,0"
                    Command="{Binding LoginCommand}"
                    FontSize="Title"
                    IsEnabled="{Binding IsUserValid}"
                    Text="Login" />
                <Label
                    Grid.Row="7"
                    Grid.ColumnSpan="2"
                    Margin="0,20,0,0"
                    FontSize="Title"
                    LineBreakMode="WordWrap" 
                    Text="{Binding LoginResult}"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>